# ════════════════════════════════════════════════════════════════════════
#  Configuration MLflow — copiez ce fichier en ".env" et remplissez vos valeurs.
#  ⚠️ .env ne doit JAMAIS être versionné (il est dans .gitignore) : secrets !
#  Si une variable est absente, le code retombe automatiquement en LOCAL.
# ════════════════════════════════════════════════════════════════════════

# ── Backend store : métriques, paramètres, métadonnées (PostgreSQL / Neon) ──
MLFLOW_TRACKING_URI=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require

# ── Artifact store : modèles & fichiers lourds (S3) ──
# Racine S3 où MLflow stocke les artefacts (créée à la 1re expérience).
MLFLOW_ARTIFACT_LOCATION=s3://ton-bucket-getaround/mlflow-artifacts
# Identifiants AWS utilisés par boto3 pour accéder au bucket :
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-west-3
